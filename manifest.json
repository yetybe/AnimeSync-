{
    "manifest_version": 3,
    "name":"AnimeSync",
    "version" : "1.0.0",
    "description": "Ver anime de manera syncronizada y remota",
    "content_scripts": [
   {
     "matches": ["*://*.crunchyroll.com/*"],
     "js": ["content.js"]
   }
 ],
    "background": {
      "service_worker" : "background.js",
      "type" : "module"
    }
}